# Banco de Dados
DATABASE_URL=postgresql://postgres:12345@localhost:5432/le_contagem

# Segurança
SECRET_KEY=seu-segredo-super-forte-aqui-mude-em-producao-123456
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Ambiente
ENVIRONMENT=development
DEBUG=True

# Configurações da API
API_V1_PREFIX=/api/v1
PROJECT_NAME="Lideranças Empáticas API"

# CORS (em desenvolvimento)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Storage (para evidências)
STORAGE_TYPE=local  # local ou s3
STORAGE_PATH=./evidencias
# AWS S3 (se usar)
# AWS_ACCESS_KEY_ID=seu-access-key
# AWS_SECRET_ACCESS_KEY=seu-secret-key
# AWS_BUCKET_NAME=le-evidencias
# AWS_REGION=us-east-1

# Configurações do Admin (opcional - apenas para criação inicial)
ADMIN_EMAIL=admin@le.com
ADMIN_PASSWORD=admin123