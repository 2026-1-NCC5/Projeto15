<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDashCoordenador"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1B5E20"
        app:navigationIcon="@drawable/abc_ic_ab_back_material"
        app:navigationIconTint="#FFFFFF"
        app:title="Carregando..."
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/cardResumoEquipe"
        android:layout_below="@id/toolbarDashCoordenador">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Gráfico Comparativo -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Produção por Alimento (kg)"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginBottom="8dp"/>

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/barChartEquipeUnica"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Lista Detalhada -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDetalheAlimentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_equipe_detalhe" />

        </LinearLayout>
    </ScrollView>

    <!-- Resumo Global Fixo -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardResumoEquipe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtPercentualEquipe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atingimento: 0%"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1B5E20" />

            <TextView
                android:id="@+id/txtKilosEquipe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0 kg totais"
                android:textColor="#666666" />

            <ProgressBar
                android:id="@+id/progressGlobalEquipe"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                android:progressTint="#1B5E20" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>