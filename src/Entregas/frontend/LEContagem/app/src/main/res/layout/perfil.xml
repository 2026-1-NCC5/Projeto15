<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_login">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_branco"
            android:padding="26dp"
            android:elevation="7dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Configurações de Perfil"
                android:textColor="#4CAF50"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

            <TextView android:id="@+id/txtNomeAtual" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#4CAF50" android:text="Nome: "/>
            <EditText android:id="@+id/edtNome" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Mudar nome" android:background="@drawable/edittext_background" android:padding="12dp" android:layout_marginBottom="12dp"/>

            <TextView android:id="@+id/txtEmailAtual" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#4CAF50" android:text="Email: "/>
            <EditText android:id="@+id/edtEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Mudar email" android:background="@drawable/edittext_background" android:padding="12dp" android:layout_marginBottom="12dp"/>

            <TextView android:id="@+id/txtSenhaAtual" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#4CAF50" android:text="Senha atual: ********"/>
            <EditText android:id="@+id/edtSenha" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nova senha" android:inputType="textPassword" android:background="@drawable/edittext_background" android:padding="12dp" android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cargo" android:textStyle="bold"/>
            <Spinner android:id="@+id/spinnerCargo" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Equipe" android:textStyle="bold"/>
            <Spinner android:id="@+id/spinnerEquipe" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="20dp"/>

            <Button android:id="@+id/btnSalvar" android:layout_width="match_parent" android:layout_height="55dp" android:text="Salvar Alterações" android:backgroundTint="#4CAF50" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnVoltarHome" android:layout_width="match_parent" android:layout_height="55dp" android:text="Voltar" android:backgroundTint="#8BC34A" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnDeslogar" android:layout_width="match_parent" android:layout_height="55dp" android:text="Sair da Conta" android:backgroundTint="#D32F2F" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>