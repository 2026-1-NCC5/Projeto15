<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- TOPO VERDE -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="#4CAF50"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gerenciar Metas"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- CONTEÚDO -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- EQUIPE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Equipe"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <Spinner
                android:id="@+id/spinnerEquipe"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:minHeight="48dp"/>

            <!-- ALIMENTO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alimento"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="18dp"/>

            <Spinner
                android:id="@+id/spinnerAlimento"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:minHeight="48dp"/>

            <!-- QUANTIDADE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meta (kg Ou litros)"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="18dp"/>

            <EditText
                android:id="@+id/edtQuantidade"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ex: 150 kg OU litros"
                android:inputType="number"
                android:padding="12dp"
                android:background="@drawable/card_equipes"/>

            <!-- DATA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data limite"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="18dp"/>

            <EditText
                android:id="@+id/edtDataLimite"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="DD/MM/AAAA"
                android:padding="12dp"
                android:background="@drawable/card_equipes"/>

            <!-- BOTÃO SALVAR -->
            <Button
                android:id="@+id/btnSalvarMeta"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Salvar Meta"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:backgroundTint="#4CAF50"/>

            <!-- BOTÃO VOLTAR -->
            <Button
                android:id="@+id/btnVoltar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Voltar para Home"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:backgroundTint="#4CAF50"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>