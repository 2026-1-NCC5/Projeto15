<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:id="@+id/topBarContagem"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#4CAF50"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar Contagem"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarContagem">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sua Equipe Atual:"
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtEquipeFixa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Carregando equipe..."
                        android:textColor="#4CAF50"
                        android:textSize="22sp"
                        android:paddingVertical="8dp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginBottom="16dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Qual o alimento?" android:textStyle="bold"/>
                    <Spinner
                        android:id="@+id/spinnerAlimentoContagem"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="16dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quantidade (kg OU litros)" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/edtQuantidadeKg"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Ex: 120"
                        android:inputType="numberDecimal"
                        android:layout_marginBottom="16dp"
                        android:padding="10dp"
                        android:background="@drawable/card_equipes"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Data do Registro" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/edtDataContagem"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="DD/MM/AAAA"
                        android:inputType="date"
                        android:layout_marginBottom="24dp"
                        android:padding="10dp"
                        android:background="@drawable/card_equipes"/>

                    <Button
                        android:id="@+id/btnSalvarContagem"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="CONFIRMAR REGISTRO"
                        android:backgroundTint="#4CAF50"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnVoltarContagem"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="10dp"
                        android:text="CANCELAR"
                        android:textColor="#4CAF50"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>